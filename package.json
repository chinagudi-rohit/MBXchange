{
  "name": "mbxchange",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "cross-env API_PORT=8787 tsx watch --ignore \".data/**\" --ignore \"src/**\" server/index.ts",
    "build": "vite build && npm run build:api",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --external:pg --external:@electric-sql/pglite --external:bcryptjs --external:jsonwebtoken --external:express --external:dotenv --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" && cp server/schema.sql dist-server/schema.sql",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "clean": "rimraf dist dist-server .data",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
