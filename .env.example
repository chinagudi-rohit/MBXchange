# ── MBXchange environment ──────────────────────────────────────────────
# Local dev needs NOTHING set — the API runs on an embedded file-backed
# Postgres (PGlite) and sensible defaults. Copy to .env only to override.

# External PostgreSQL (production / docker / AKS). When unset, embedded PGlite is used.
# DATABASE_URL=postgres://mbx:password@localhost:5432/mbxchange
# Set to "require" for Azure Database for PostgreSQL (TLS).
# PGSSL=require

# REQUIRED in production: long random string for signing JWTs.
# JWT_SECRET=

# API port (defaults to 8787 in dev, 8080 in the container).
# API_PORT=8787

# Override seeded demo passwords (defaults: Mbx@2026 / MBXAdmin@2026).
# SEED_USER_PASSWORD=
# SEED_ADMIN_PASSWORD=

# ── PRODUCTION SWITCH ──────────────────────────────────────────────────
# The sign-in screen has a "Sign in as any user (pilot environment)" panel
# that lists every active account so testers can jump between them.
#
# Set this to false for any real deployment. That single change:
#   * makes GET /api/auth/demo-accounts return 404
#   * hides the panel on the login screen entirely
# Nothing else needs editing, and no code changes are required.
DEMO_ACCOUNTS=true

# Skip seeding the demo dataset (users, requirements, carpool, marketplace).
# Leave unset for a pilot; set to true for a production database you will
# populate yourself through the admin console.
# SKIP_SEED=true

# Bootstrap administrator, created only when the database has no admin yet.
# REQUIRED alongside SKIP_SEED=true, otherwise nobody can sign in.
# The account is forced to change its password on first sign-in.
# ADMIN_EMAIL=admin@mercedes-benz.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Platform Administrator
# ADMIN_DEPARTMENT=PT-THIT
